# ---------------------------------------------------------------------------
# HIM - MDT platform environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Connection string for the application database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/him?schema=public"
# Optional: separate URL for migration/CI runs with elevated privileges.
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/him?schema=public"

# Local, Docker-less development database (npm-distributed PostgreSQL server).
# Used by `npm run db:local`.
DEV_DB_PORT=5433
DEV_DB_USER=postgres
DEV_DB_PASSWORD=postgres
DEV_DB_NAME=him

# --- Authentication -------------------------------------------------------
# Secret used to derive session-token hashes. MUST be unique per environment
# and at least 32 characters long. Rotate with care (invalidates sessions).
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-min-32-chars"
# Session lifetime in hours (default 12). Idle sessions expire at the same time.
SESSION_TTL_HOURS=12
# Name of the session cookie.
SESSION_COOKIE_NAME="him_session"
# "auto" detects HTTPS per request (x-forwarded-proto / Forwarded / Origin /
# Referer). Set "true" if your proxy hides the scheme, "false" only when the
# site really is served over plain HTTP.
COOKIE_SECURE="auto"
# "auto" sends SameSite=None when the cookie is Secure (required when the app is
# embedded in a frame on another site) and SameSite=Lax otherwise.
COOKIE_SAMESITE="auto"
# Extra origins allowed to call the API (comma separated).
TRUSTED_ORIGINS=""
# Reject state-changing requests that browsers report as cross-site.
CSRF_PROTECTION="true"
# "none"      - no sign-in at all: every request runs as OPERATOR_USER, with
#               that account's real roles and permissions (demos, previews,
#               single-operator installs, embedded displays).
# "password"  - accounts sign in with a username/email and password.
AUTH_MODE="password"
# The account every request runs as when AUTH_MODE=none (username or email).
OPERATOR_USER="admin"
# Number of failed sign-in attempts before the account is temporarily locked.
MAX_FAILED_LOGINS=8
# Account lockout duration in minutes.
ACCOUNT_LOCKOUT_MINUTES=15

# --- Application ----------------------------------------------------------
# Public URL of the deployment (used in emails and absolute links).
APP_URL="http://localhost:3000"
# Log level: debug | info | warn | error
LOG_LEVEL="info"
# Structured JSON logs (recommended in production).
LOG_JSON="false"

# --- File storage ---------------------------------------------------------
# Storage driver: local | s3 (s3 adapter is stubbed behind the same interface)
STORAGE_DRIVER="local"
# Where uploaded attachments are written for the local driver.
STORAGE_LOCAL_DIR="./storage/uploads"
# Maximum attachment size in megabytes.
MAX_UPLOAD_MB=25

# --- Providers (adapters; defaults are safe no-op/mock implementations) ----
# Search provider: postgres | none
SEARCH_PROVIDER="postgres"
# Realtime provider: local (in-process event bus) | none
REALTIME_PROVIDER="local"
# Dispatch provider: mock | none
DISPATCH_PROVIDER="mock"
# Notification delivery: in-app | none (email adapter behind EmailProvider)
NOTIFICATION_PROVIDER="in-app"
# Email provider: console | none
EMAIL_PROVIDER="console"

# --- Optional integrations -------------------------------------------------
# Maps provider (optional). When unset, map widgets are simply not rendered.
# MAPS_PROVIDER="none"
# NEXT_PUBLIC_MAPS_API_KEY=""

# FiveM integration: shared secret the game server uses to exchange a citizen id
# for a short-lived player token. Role keys are the seeded ones (operator,
# supervisor, standard, readonly, administrator). See fivem/README.md.
FIVEM_API_KEY=""
FIVEM_TOKEN_TTL_HOURS="12"
FIVEM_AUTO_PROVISION="false"
# e.g. {"police":"operator","sheriff":"operator"}
FIVEM_JOB_ROLES="{}"
